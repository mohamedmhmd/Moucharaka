# Copy to .env and adjust. Every value can also be set as a real environment variable.
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=moucharaka.mr,www.moucharaka.mr
CSRF_TRUSTED_ORIGINS=https://moucharaka.mr,https://www.moucharaka.mr
# Behind a reverse proxy that terminates HTTPS (nginx, Caddy, Render, Railway…)
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Database (sqlite by default). Examples:
# DATABASE_URL=postgres://moucharaka:password@localhost:5432/moucharaka
# DATABASE_URL=mysql://user:password@localhost:3306/moucharaka
DATABASE_URL=sqlite:///db.sqlite3

# Cache used for OTP throttling. Use Redis when running several workers/servers.
# CACHE_URL=redis://localhost:6379/1
CACHE_URL=locmemcache://

# Default language for URLs without prefix: ar or fr
LANGUAGE_CODE=ar

# Uploaded files. PRIVATE_MEDIA_ROOT holds identity documents: never expose it through the web server.
MEDIA_ROOT=/var/lib/moucharaka/media
PRIVATE_MEDIA_ROOT=/var/lib/moucharaka/private_media
# Let Django serve /media/ (fine for small sites; set False when nginx serves it)
SERVE_MEDIA=True

# Messaging: WhatsApp providers are configured in the admin (Messagerie › Fournisseurs de messagerie).
# See docs/WHATSAPP.md. Codes go to WhatsApp first, then SMS if an SMS provider exists.
OTP_CHANNELS=whatsapp,sms
NOTIFICATION_CHANNELS=whatsapp
# Used only when no provider is configured: console = print to the server log (development).
MESSAGING_FALLBACK_BACKEND=console
# Countries allowed to sign up (ISO codes, or * for the whole world)
PHONE_ALLOWED_COUNTRIES=*
# Hours a new payment account waits before it can receive a withdrawal
NEW_PAYMENT_ACCOUNT_HOLD_HOURS=24
OTP_TTL_SECONDS=300
OTP_MAX_PER_HOUR=5
# Testing without WhatsApp: show the code on the page. Set to False before the public launch.
OTP_SHOW_ON_SCREEN=False

# Payment webhooks (HMAC-SHA256 shared secret given to Bankily/Masrvi/Sedad integrators)
PAYMENT_WEBHOOK_SECRET=

# Optional e-mail (smtp+tls://user:password@smtp.example.com:587)
EMAIL_URL=consolemail://
